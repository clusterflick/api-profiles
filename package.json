{
  "name": "api-profiles",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "lint": "tsc --noEmit && tsc --noEmit -p test",
    "format": "prettier --write --ignore-path .gitignore --ignore-path .prettierignore .",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "bench:cpu": "esbuild bench/cpu.ts --bundle --platform=node --format=esm --log-level=warning | node --input-type=module"
  },
  "dependencies": {
    "@clusterflick/accounts": "0.1.0",
    "@fontsource/montserrat": "5.3.0",
    "@jsquash/jpeg": "1.6.0",
    "@resvg/resvg-wasm": "2.6.2",
    "satori": "0.32.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.2.8",
    "esbuild": "^0.28.2",
    "jose": "^6.2.17",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "~4.1.0",
    "wrangler": "^4.141.0"
  }
}
