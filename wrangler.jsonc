{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clusterflick-api-profiles",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // Everything under /u is this Worker's. `/u/*` also matches `/u/`, but not
  // the bare `/u`, so that gets a route of its own.
  "routes": [
    { "pattern": "clusterflick.com/u/*", "zone_name": "clusterflick.com" },
    { "pattern": "clusterflick.com/u", "zone_name": "clusterflick.com" },
    // The purge, beside api-tmdb-search's /api/tmdb/*.
    {
      "pattern": "clusterflick.com/api/profiles/*",
      "zone_name": "clusterflick.com",
    },
  ],
  "workers_dev": false,
  "vars": {
    // Public: it's in the site's Firebase web config too.
    "FIREBASE_PROJECT_ID": "clusterflick-com",
    // Where the shell page is fetched from. `.dev.vars` points it at `next dev`.
    "SITE_ORIGIN": "https://clusterflick.com",
  },
  // The service account's JSON key, on one line. Set with
  // `wrangler secret put FIREBASE_SERVICE_ACCOUNT`, locally in `.dev.vars`.
  // PURGE_SECRET is what the site's scripts send to /api/profiles/purge, as
  // they run as the service account and have no ID token.
  "secrets": { "required": ["FIREBASE_SERVICE_ACCOUNT", "PURGE_SECRET"] },
  // A profile's cached copy, one object per handle, and the handles each
  // reader's copies are filed under, one per uid (src/cache.ts).
  "durable_objects": {
    "bindings": [
      { "name": "PROFILES", "class_name": "ProfileCache" },
      { "name": "UID_INDEX", "class_name": "UidIndex" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ProfileCache", "UidIndex"] },
  ],
  // Per-location and approximate: they deter abuse rather than enforce a
  // quota. Namespace ids are unique in the account; api-tmdb-search has 1xxx.
  "ratelimits": [
    // Uncached profile views per IP: each costs Firestore reads, and a
    // crawler trying handles would make one for every handle it tried.
    {
      "name": "MISS_LIMIT",
      "namespace_id": "2001",
      "simple": { "limit": 30, "period": 60 },
    },
    // Purges per reader: each makes their next view read Firestore.
    {
      "name": "PURGE_LIMIT",
      "namespace_id": "2002",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  // api-tmdb-search has 8787; the site's `next dev` sends /u/* here.
  "dev": { "port": 8788 },
  // Workers Paid has no spend cap, so a ceiling per request. A 10,000-film
  // profile costs ~80ms (`npm run bench:cpu`), so this is headroom, not a fit.
  "limits": { "cpu_ms": 1000 },
  "observability": { "enabled": true },
}
